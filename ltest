# -a lists . and .., and -R used to descend into both, forever. head bounds
# the output so a regression fails the check instead of hanging the suite.
testRecursiveAllSkipsDotAndDotDot() {
    setup
    mkdir sub
    touch sub/file
    check "$(l -aR -1 | head -n 20)" = ".:
.
..
sub

./sub:
.
..
file"
    cleanup
}

# Directory headers are file names too, and -R prints ones anybody could
# have created, so they get the same escaping as the names in the listing.
testRecursiveEscapesDirectoryHeaders() {
    setup
    mkdir $'d\033x'
    touch $'d\033x/f'
    check "$(l -qR -1)" = ".:
d?x

./d?x:
f"
    cleanup
}

# A symlink target can be PATH_MAX-1 bytes long. The buffer was one byte
# short of that, and the failure that followed crashed -l and -V.
testLongSymlinkTarget() {
    setup
    max="$(getconf PATH_MAX .)"
    target="$(printf "%$((max - 1))s" | tr ' ' a)"
    ln -s "$target" link
    result="$(l -l link 2>/dev/null)" || true
    check "${result##* -> }" = "$target"
    result="$(l -V -1 link 2>/dev/null)" || true
    check "$result" = "link -> $target"
    cleanup
}

# A color setup that fails partway (no TERM, or a terminal without colors)
# used to free uninitialized pointers. The perturb settings fill fresh
# allocations with garbage (glibc and macOS respectively), so that free is
# a reliable crash rather than one that depends on what the heap held.
testColorWithoutColorTerminal() {
    setup
    touch file
    status=0
    result="$(MALLOC_PERTURB_=165 MallocPreScribble=1 TERM=dumb l -G -1)" || status=$?
    check "$status" = 0
    check "$result" = "file"
    status=0
    result="$(MALLOC_PERTURB_=165 MallocPreScribble=1 env -u TERM "$OUTDIR/l" -G -1)" || status=$?
    check "$status" = 0
    check "$result" = "file"
    cleanup
}

# A time too far from the epoch for localtime() used to fail the time field,
# which dropped every file's line from the listing. Only tmpfs keeps such a
# time, and only GNU touch sets one, so this skips anywhere else.
testFarFutureTimestamp() {
    if ! test -d /dev/shm || ! test -w /dev/shm; then
        echo "${FUNCNAME[0]} SKIPPED: no writable /dev/shm"
        return 0
    fi
    TMPDIR=/dev/shm setup
    touch b
    touch -d @2305843009213693952 a 2>/dev/null || true
    if test "$(stat -c %Y a 2>/dev/null)" != 2305843009213693952; then
        cleanup
        echo "${FUNCNAME[0]} SKIPPED: /dev/shm cannot hold the time"
        return 0
    fi
    result="$(l -T -1)"
    check "$(echo "$result" | head -n 1)" = "2305843009213693952 a"
    last="$(echo "$result" | tail -n 1)"
    check "${last##* }" = "b"
    cleanup
}

# -f used to set the sort function only for it to be overwritten from the
# sort type, so it sorted by name. Directory order is whatever the file
# system returns, so compare against -U rather than a fixed order.
testUnsortedF() {
    setup
    for name in m q c x a t f k z b; do
        touch "$name"
    done
    check "$(l -f -1)" = "$(l -U -1)"
    check "$(l -f -r -1)" = "$(l -U -1)"
    cleanup
}

# DEL has no named C escape, and -e used to print it raw.
testEscapeDel() {
    setup
    touch $'a\177b'
    check "$(l -e -1)" = 'a\177b'
    cleanup
}

# getopt sets optopt to 0 for a long option, so these used to print a NUL
# where the option's name belonged.
testLongOptionErrorsNameTheOption() {
    status=0
    result="$(l --bogus 2>&1 >/dev/null)" || status=$?
    check "$status" = 2
    check "$result" != "${result/Unknown option --bogus/}"
    status=0
    result="$(l --sort 2>&1 >/dev/null)" || status=$?
    check "$status" = 2
    check "$result" != "${result/Missing argument to --sort/}"
}

# POSIX ls exits non-zero when an operand cannot be listed; this exited 0.
testMissingOperandExitStatus() {
    setup
    touch file
    status=0
    result="$(l -1 file missing 2>/dev/null)" || status=$?
    check "$status" = 1
    check "$result" = "file"
    cleanup
}

testUnreadableDirectoryExitStatus() {
    if test "$(id -u)" = 0; then
        echo "${FUNCNAME[0]} SKIPPED: root can open any directory"
        return 0
    fi
    setup
    mkdir dir
    chmod 000 dir
    status=0
    l dir >/dev/null 2>&1 || status=$?
    chmod 755 dir
    check "$status" = 1
    cleanup
}

# In a directory that can be read but not searched, readdir() works and
# lstat() of each entry fails, so -l shows ? fields: an incomplete listing,
# which exited 0. A names-only listing needs no stat, so it still succeeds.
testUnsearchableDirectoryExitStatus() {
    if test "$(id -u)" = 0; then
        echo "${FUNCNAME[0]} SKIPPED: root can search any directory"
        return 0
    fi
    setup
    mkdir dir
    touch dir/file
    chmod 444 dir
    status=0
    result="$(l -l dir 2>/dev/null)" || status=$?
    plainstatus=0
    plain="$(l -1 dir 2>/dev/null)" || plainstatus=$?
    # -D stats each entry only to filter it out of the listing
    dirsstatus=0
    l -D -1 dir >/dev/null 2>&1 || dirsstatus=$?
    chmod 755 dir
    check "$status" = 1
    check "$result" != "${result/\?\?\?/}"
    check "$plainstatus" = 0
    check "$plain" = "file"
    check "$dirsstatus" = 1
    cleanup
}

# readdir() returns NULL for an error as well as at the end of a directory,
# and an error used to pass for the end: a partial listing that exited 0.
# No real file system fails on demand, so a preloaded readdir() fails at
# the entry named "fail"; LD_PRELOAD limits this to Linux.
testReaddirFailureExitStatus() {
    if test "$(uname)" != Linux; then
        echo "${FUNCNAME[0]} SKIPPED: needs LD_PRELOAD"
        return 0
    fi
    setup
    cat > shim.c <<'EOF'
#define _GNU_SOURCE
#include <dirent.h>
#include <dlfcn.h>
#include <errno.h>
#include <string.h>

struct dirent *readdir(DIR *dir)
{
    static struct dirent *(*real)(DIR *);
    if (!real) {
        real = (struct dirent *(*)(DIR *))dlsym(RTLD_NEXT, "readdir");
    }
    struct dirent *dirent = real(dir);
    if (dirent && strcmp(dirent->d_name, "fail") == 0) {
        errno = EIO;
        return NULL;
    }
    return dirent;
}
EOF
    ${CC:-cc} -shared -fPIC -o shim.so shim.c -ldl
    mkdir dir
    touch dir/fail
    status=0
    err="$(LD_PRELOAD="$PWD/shim.so" l -1 dir 2>&1 >/dev/null)" || status=$?
    check "$status" = 1
    check "$err" != "${err/Cannot read dir/}"
    cleanup
}

# Error messages carry file names, so they are escaped too: a name holding a
# terminal escape sequence used to reach the terminal raw through stderr.
testDiagnosticsEscapeNames() {
    setup
    name=$'loop\033]0;pwned\a'
    ln -s "$name" "$name"
    result="$(l -L -1 2>&1 >/dev/null)"
    esc=$'\033'
    check "$result" = "${result//$esc/}"
    check "$result" != "${result/'loop\033]0;pwned\007'/}"
    cleanup
}

# BLOCKSIZE=-512 used to wrap around to a huge unsigned block size. A value
# too big for a long has to be ignored too, including where long is no wider
# than int and strtol() clamps it to exactly INT_MAX.
testBlocksizeIgnoresNonPositive() {
    setup
    echo data > file
    check "$(BLOCKSIZE=-512 l -s -1 file)" = "$(l -k -s -1 file)"
    check "$(BLOCKSIZE=99999999999999999999 l -s -1 file)" = "$(l -k -s -1 file)"
    cleanup
}

# -V prints a loop up to and including the name that closes it, and -L
# reports one rather than following it forever.
testSymlinkLoops() {
    setup
    ln -s self self
    ln -s b a
    ln -s a b
    check "$(l -V -1 self 2>/dev/null)" = "self -> self"
    check "$(l -V -1 a 2>/dev/null)" = "a -> b -> a"
    err="$(l -L -1 a 2>&1 >/dev/null)" || true
    check "$err" != "${err/Symlink loop/}"
    cleanup
}

# Loop detection compared inode numbers alone, which are only unique within
# one file system, so a chain through two file systems that happened to
# share one was cut short as a loop. Each tmpfs numbers its own inodes, so
# the first file made in each of two fresh mounts collides. Mounting takes
# a private mount namespace, which some kernels refuse an ordinary user.
testLoopDetectionAcrossFileSystems() {
    if ! unshare -rm true 2>/dev/null; then
        echo "${FUNCNAME[0]} SKIPPED: no private mount namespace"
        return 0
    fi
    setup
    mkdir a b
    result="$(unshare -rm sh -c '
        mount -t tmpfs none a && mount -t tmpfs none b || exit 1
        ln -s "$PWD/b/second" a/first
        ln -s real b/second
        touch b/real
        ln -s a/first start
        if test "$(stat -c %i a/first)" != "$(stat -c %i b/second)"; then
            echo "no collision"
            exit 0
        fi
        "$1" -V -1 start 2>&1
        "$1" -L -M -1 start 2>&1
    ' sh "$OUTDIR/l")" || true
    if test "$result" = "no collision"; then
        cleanup
        echo "${FUNCNAME[0]} SKIPPED: inode numbers did not collide"
        return 0
    fi
    check "$(echo "$result" | head -n 1)" = "start -> a/first -> $PWD/b/second -> real"
    # -L shows the modes of real itself, not ? fields after a false loop
    check "$result" = "${result/Symlink loop/}"
    check "$result" = "${result/\?/}"
    cleanup
}

# Where a relative symlink leads depends on the directory it is reached
# through, so hard links to one symlink in two directories are not a loop:
# here d1/a leads to d1/next, which leads to d2/a, the same symlink, which
# leads to d2/next. A loop that comes back through a different spelling of
# the same directory is still one. Skips where a symlink cannot be
# hard-linked.
testHardLinkedSymlinkIsNotALoop() {
    setup
    mkdir d1 d2
    ln -s next d1/a
    if ! ln -P d1/a d2/a 2>/dev/null || ! test -L d2/a; then
        cleanup
        echo "${FUNCNAME[0]} SKIPPED: cannot hard-link a symlink"
        return 0
    fi
    ln -s ../d2/a d1/next
    touch d2/next
    check "$(l -V -1 d1/a 2>&1)" = "d1/a -> next -> ../d2/a -> next"
    result="$(l -L -M -1 d1/a 2>&1)" || true
    check "$result" = "${result/Symlink loop/}"
    check "$result" = "${result/\?/}"
    ln -s ../d1/back d1/back
    err="$(l -L -1 d1/back 2>&1 >/dev/null)" || true
    check "$err" != "${err/Symlink loop/}"
    cleanup
}

# Regression test for the $* fix in check(): a failure on more than one
# argument used to print via $@, which passes each argument to echo
# separately instead of as one joined string (shellcheck SC2145). bash's
# echo builtin re-joins multiple arguments with a single space, so a plain
# string comparison on the printed line can't tell $@ and $* apart here —
# override echo to reveal the argument boundaries instead: $* produces one
# bracketed group, a regression to $@ would split "a = b" into three.
testCheckFormatsMultiArgFailure() {
    echo() { printf '<%s>' "$@"; printf '\n'; }
    result="$(check "a" = "b" 2>&1)" || true
    unset -f echo
    check "$result" = "<testCheckFormatsMultiArgFailure FAILURE: a = b>"
}

